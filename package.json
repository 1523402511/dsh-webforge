{
  "name": "dsh-webforge",
  "version": "0.3.0",
  "description": "把网页素材库做成本地 DSH 工具：搜库、读设计体系、拼初稿、把 deck 打成 PDF。零依赖，只读源库；没装完整库时用包内起步库。",
  "type": "module",
  "main": "./plugin.mjs",
  "exports": {
    ".": "./plugin.mjs",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "web",
    "design-system",
    "template"
  ],
  "files": [
    "plugin.mjs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "library"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
